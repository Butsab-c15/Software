<script>

/* =========================================================
   CART
========================================================= */

function getActiveCart() {

  const email =
    localStorage.getItem(
      'userEmail'
    );


  try {

    return JSON.parse(
      localStorage.getItem(
        email
          ? 'cart_' + email
          : 'tempCart'
      )
    ) || [];

  } catch (error) {

    console.error(
      'Cart parse error:',
      error
    );

    return [];

  }

}


/* =========================================================
   UPDATE CART ICON
========================================================= */

function updateCartIcon() {

  const badge =
    document.getElementById(
      'cart-badge'
    );


  if (!badge) {

    return;

  }


  const count =
    getActiveCart().length;


  badge.innerText =
    count;


  badge.classList.toggle(
    'd-none',
    count === 0
  );

}



/* =========================================================
   GET CURRENT USER
========================================================= */

function getNavCurrentUser() {

  try {

    const userData =
      localStorage.getItem(
        'userData'
      );


    if (!userData) {

      return null;

    }


    const user =
      JSON.parse(userData);


    if (
      !user ||
      !user.id
    ) {

      return null;

    }


    const id =
      Number(user.id);


    if (
      !Number.isInteger(id) ||
      id <= 0
    ) {

      return null;

    }


    return {
      ...user,
      id: id
    };

  } catch (error) {

    console.error(
      'User data parse error:',
      error
    );

    return null;

  }

}



/* =========================================================
   GET USER ID
========================================================= */

function getNavUserId() {

  const user =
    getNavCurrentUser();


  if (!user) {

    return null;

  }


  return user.id;

}



/* =========================================================
   LOAD WISHLIST FROM MYSQL
========================================================= */

async function getWishlistFromDatabase() {

  const userId =
    getNavUserId();


  /*
   * ถ้ายังไม่ได้ Login
   * ไม่มี Wishlist
   */

  if (!userId) {

    return [];

  }


  try {

    const response =
      await fetch(
        '/api/favorites',
        {
          method: 'GET',

          headers: {
            'X-User-Id':
              String(userId)
          }
        }
      );


    /*
     * ถ้า Server ตอบ error
     */

    if (!response.ok) {

      console.error(
        'Get wishlist failed:',
        response.status
      );

      return [];

    }


    const data =
      await response.json();


    console.log(
      'Wishlist from database:',
      data
    );


    if (
      !data.success
    ) {

      return [];

    }


    return Array.isArray(
      data.favorites
    )
      ? data.favorites
      : [];

  } catch (error) {

    console.error(
      'Load wishlist error:',
      error
    );

    return [];

  }

}



/* =========================================================
   UPDATE WISHLIST ICON
   ใช้ข้อมูลจาก MYSQL
========================================================= */

async function updateWishlistIcon() {

  const badge =
    document.getElementById(
      'wishlist-badge'
    );


  const icon =
    document.getElementById(
      'nav-wishlist-icon'
    );


  if (!badge) {

    return;

  }


  const wishlist =
    await getWishlistFromDatabase();


  const count =
    wishlist.length;


  /*
   * แสดงจำนวน
   */

  badge.innerText =
    count;


  /*
   * ซ่อน badge ถ้าไม่มีสินค้า
   */

  badge.classList.toggle(
    'd-none',
    count === 0
  );


  /*
   * เปลี่ยน icon
   */

  if (icon) {

    icon.className =
      count > 0
        ? 'bi bi-heart-fill text-danger fs-5'
        : 'bi bi-heart fs-5';

  }

}



/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(value) {

  return String(
    value ?? ''
  )

    .replace(
      /&/g,
      '&amp;'
    )

    .replace(
      /</g,
      '&lt;'
    )

    .replace(
      />/g,
      '&gt;'
    )

    .replace(
      /"/g,
      '&quot;'
    )

    .replace(
      /'/g,
      '&#039;'
    );

}



/* =========================================================
   OPEN WISHLIST
========================================================= */

async function openWishlist() {

  const userId =
    getNavUserId();


  /*
   * ถ้ายังไม่ได้ Login
   * ให้ไป Login ก่อน
   */

  if (!userId) {

    const currentUrl =
      window.location.pathname +
      window.location.search;


    window.location.href =
      `/login?redirect=${encodeURIComponent(
        currentUrl
      )}`;

    return;

  }


  /*
   * โหลดข้อมูลจาก Database
   */

  await renderWishlist();


  /*
   * อัปเดตหัวใจด้านบน
   */

  await updateWishlistIcon();


  /*
   * เปิด Modal
   */

  const modalElement =
    document.getElementById(
      'wishlistModal'
    );


  if (!modalElement) {

    return;

  }


  if (
    typeof bootstrap ===
    'undefined'
  ) {

    console.error(
      'Bootstrap is not loaded'
    );

    return;

  }


  const modal =
    bootstrap.Modal.getOrCreateInstance(
      modalElement
    );


  modal.show();

}



/* =========================================================
   RENDER WISHLIST
   ใช้ข้อมูลจาก MYSQL
========================================================= */

async function renderWishlist() {

  const container =
    document.getElementById(
      'wishlist-container'
    );


  if (!container) {

    return;

  }


  /*
   * แสดง Loading
   */

  container.innerHTML = `

    <div class="text-center py-5">

      <div
        class="spinner-border text-dark mb-3"
        role="status"
      ></div>

      <div class="text-muted">
        กำลังโหลดรายการที่ชอบ...
      </div>

    </div>

  `;


  /*
   * โหลดจาก MySQL
   */

  const wishlist =
    await getWishlistFromDatabase();


  /*
   * ไม่มีสินค้า
   */

  if (
    wishlist.length === 0
  ) {

    container.innerHTML = `

      <div class="text-center py-5">

        <i
          class="bi bi-heart fs-1 text-muted"
        ></i>

        <h5 class="fw-bold mt-3">
          ยังไม่มีสินค้าที่ชอบ
        </h5>

        <p class="text-muted mb-0">
          กดหัวใจที่สินค้าที่คุณสนใจ
        </p>

      </div>

    `;

    return;

  }


  /*
   * มีสินค้า
   */

  container.innerHTML =
    wishlist
      .map(
        item => `

          <div
            class="d-flex align-items-center border rounded-4 p-3 mb-3"
          >


            <!-- IMAGE -->

            <img
              src="${escapeHtml(
                item.image
              )}"
              alt="${escapeHtml(
                item.name
              )}"
              style="
                width:90px;
                height:90px;
                object-fit:contain;
              "
              class="rounded-3 bg-light me-3"
            />


            <!-- INFO -->

            <div class="flex-grow-1">

              <div class="fw-bold">
                ${escapeHtml(
                  item.name
                )}
              </div>


              <div class="text-muted small">
                ${escapeHtml(
                  item.brand
                )}
              </div>


              <div class="fw-bold mt-1">
                ฿${escapeHtml(
                  item.price
                )}
              </div>


              ${
                item.size
                  ? `
                    <div class="text-muted small">
                      Size:
                      ${escapeHtml(
                        item.size
                      )}
                    </div>
                  `
                  : ''
              }

            </div>


            <!-- BUTTONS -->

            <div
              class="d-flex gap-2"
            >


              <!-- VIEW PRODUCT -->

              <a
                href="/shop/${encodeURIComponent(
                  item.id
                )}"
                class="btn btn-dark rounded-pill"
              >
                ดูสินค้า
              </a>


              <!-- REMOVE -->

              <button
                type="button"
                class="btn btn-outline-danger rounded-pill"
                onclick="removeFromWishlist('${String(
                  item.id
                ).replace(
                  /'/g,
                  "\\'"
                )}')"
              >

                <i
                  class="bi bi-heartbreak"
                ></i>

              </button>

            </div>

          </div>

        `
      )
      .join('');

}



/* =========================================================
   REMOVE WISHLIST
   ลบจาก MYSQL
========================================================= */

async function removeFromWishlist(id) {

  const userId =
    getNavUserId();


  /*
   * ต้อง Login
   */

  if (!userId) {

    const currentUrl =
      window.location.pathname +
      window.location.search;


    window.location.href =
      `/login?redirect=${encodeURIComponent(
        currentUrl
      )}`;

    return;

  }


  /*
   * ป้องกันการกดซ้ำ
   */

  try {

    const response =
      await fetch(
        `/api/favorites/${encodeURIComponent(
          id
        )}`,
        {
          method: 'DELETE',

          headers: {
            'X-User-Id':
              String(userId)
          }
        }
      );


    const data =
      await response.json();


    console.log(
      'Remove wishlist:',
      data
    );


    /*
     * ลบสำเร็จ
     */

    if (
      response.ok &&
      data.success
    ) {

      /*
       * โหลดรายการใหม่
       */

      await renderWishlist();


      /*
       * อัปเดตจำนวนหัวใจ
       */

      await updateWishlistIcon();


      /*
       * ถ้า Product page
       * มีปุ่มหัวใจอยู่ด้วย
       */

      if (
        typeof updateWishlistButton ===
        'function'
      ) {

        updateWishlistButton(false);

      }

    } else {

      alert(
        data.message ||
        'ไม่สามารถลบรายการที่ชอบได้'
      );

    }

  } catch (error) {

    console.error(
      'Remove wishlist error:',
      error
    );


    alert(
      'ไม่สามารถเชื่อมต่อกับ Server ได้'
    );

  }

}



/* =========================================================
   LOGIN BUTTON
========================================================= */

function setupLoginButton() {

  const email =
    localStorage.getItem(
      'userEmail'
    );


  const button =
    document.getElementById(
      'nav-login-btn'
    );


  if (!button) {

    return;

  }


  /*
   * Login แล้ว
   */

  if (email) {

    button.parentElement.innerHTML = `

      <div
        class="d-flex align-items-center ms-3 gap-2"
      >


        <!-- USER ACCOUNT -->

        <div class="dropdown">

          <button
            class="btn btn-dark dropdown-toggle rounded-pill px-3"
            type="button"
            data-bs-toggle="dropdown"
          >

            <i
              class="bi bi-person-circle me-1"
            ></i>

            ${escapeHtml(
              email
            )}

          </button>


          <ul
            class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 rounded-3"
          >

            <li>

              <a
                class="dropdown-item fw-bold"
                href="/me"
              >
                My Account
              </a>

            </li>

          </ul>

        </div>


        <!-- LOGOUT -->

        <button
          type="button"
          class="btn btn-outline-danger rounded-pill px-3"
          onclick="logout()"
        >

          <i
            class="bi bi-box-arrow-right me-1"
          ></i>

          Logout

        </button>

      </div>

    `;

  } else {


    /*
     * ยังไม่ได้ Login
     */

    if (
      ![
        '/login',
        '/register'
      ].includes(
        window.location.pathname
      )
    ) {

      const currentUrl =
        encodeURIComponent(
          window.location.pathname +
          window.location.search
        );


      button.href =
        `/login?redirect=${currentUrl}`;

    }

  }

}



/* =========================================================
   LOGOUT
========================================================= */

function logout() {

  localStorage.removeItem(
    'userEmail'
  );


  localStorage.removeItem(
    'userData'
  );


  window.location.href =
    '/';

}



/* =========================================================
   PAGE LOAD
========================================================= */

document.addEventListener(
  'DOMContentLoaded',
  async function () {

    /*
     * Cart
     */

    updateCartIcon();


    /*
     * Wishlist
     * โหลดจาก MySQL
     */

    await updateWishlistIcon();


    /*
     * Login
     */

    setupLoginButton();

  }
);

</script>