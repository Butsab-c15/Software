        <div class="input-group bg-light rounded-1" style="background-color: #434242; height: 36px; width: 100%; max-width: 500px;">
          <!-- ไอคอนแว่นขยาย -->
          <span class="input-group-text bg-transparent border-0 pe-2 text-muted d-flex align-items-center">
            <i class="bi bi-search" style="font-size: 0.85rem;"></i>
          </span>
          <input class="form-control bg-transparent border-0 ps-1 h-100" type="search" placeholder="Search for brand" style="box-shadow: none; font-size: 0.85rem;" />
