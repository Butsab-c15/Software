<script>

document.addEventListener("DOMContentLoaded", function () {

  /* =====================================================
     ELEMENTS
     ===================================================== */

  const filterButtons =
    document.querySelectorAll(".filter-button");

  const filterPanel =
    document.getElementById("filterPanel");

  const filterOverlay =
    document.getElementById("filterOverlay");

  const closeFilter =
    document.getElementById("closeFilter");

  const filterTitles =
    document.querySelectorAll(".filter-title");

  const clearFilters =
    document.getElementById("clearFilters");

  const selectedFilters =
    document.getElementById("selectedFilters");

  const brandSearch =
    document.getElementById("brandSearch");

  const customSizeCheck =
    document.getElementById("customSizeCheck");

  const customSizeInput =
    document.getElementById("customSizeInput");

  const products =
    document.querySelectorAll(".product-item");


  /* =====================================================
     OPEN FILTER PANEL
     ===================================================== */

  function openPanel(sectionName) {

    if (!filterPanel || !filterOverlay) {
      return;
    }

    filterPanel.classList.add("active");

    filterOverlay.classList.add("active");

    document.body.style.overflow = "hidden";


    filterTitles.forEach(function (title) {

      const section =
        title.getAttribute("data-section");

      const content =
        document.getElementById(
          "filter-" + section
        );

      const icon =
        title.querySelector("i");


      if (section === sectionName) {

        if (content) {
          content.style.display = "block";
        }

        if (icon) {

          icon.classList.remove(
            "bi-chevron-down"
          );

          icon.classList.add(
            "bi-chevron-up"
          );
        }
      }
    });
  }


  /* =====================================================
     FILTER BAR BUTTON
     ===================================================== */

  filterButtons.forEach(function (button) {

    button.addEventListener(
      "click",
      function () {

        const section =
          button.getAttribute(
            "data-filter"
          );

        openPanel(section);

      }
    );

  });
  
  /* =====================================================
     CLOSE PANEL
     ===================================================== */

  function closePanel() {

    if (!filterPanel || !filterOverlay) {
      return;
    }

    filterPanel.classList.remove("active");

    filterOverlay.classList.remove("active");

    document.body.style.overflow = "";

  }


  if (closeFilter) {

    closeFilter.addEventListener(
      "click",
      closePanel
    );

  }


  if (filterOverlay) {

    filterOverlay.addEventListener(
      "click",
      closePanel
    );

  }

  /* =====================================================
     OPEN / CLOSE FILTER SECTION
     ===================================================== */

  filterTitles.forEach(function (title) {

    title.addEventListener(
      "click",
      function () {

        const section =
          title.getAttribute(
            "data-section"
          );

        const content =
          document.getElementById(
            "filter-" + section
          );

        const icon =
          title.querySelector("i");


        if (!content) {
          return;
        }


        if (
          content.style.display === "none" ||
          content.style.display === ""
        ) {

          content.style.display = "block";

          if (icon) {

            icon.classList.remove(
              "bi-chevron-down"
            );

            icon.classList.add(
              "bi-chevron-up"
            );

          }

        } else {

          content.style.display = "none";

          if (icon) {

            icon.classList.remove(
              "bi-chevron-up"
            );

            icon.classList.add(
              "bi-chevron-down"
            );
          }
        }
      }
    );
  });


  /* =====================================================
     GET SELECTED FILTERS
     ===================================================== */

  function getSelectedValues(name) {

    return Array.from(
      document.querySelectorAll(
        'input[name="' + name + '"]:checked'
      )
    ).map(function (checkbox) {

      return checkbox.value
        .toLowerCase()
        .trim();

    });

  }

  /* =====================================================
     REALTIME FILTER
     ===================================================== */

  function applyFilters() {

    const selectedBrands =
      getSelectedValues("brandFilter");

    const selectedSizes =
      getSelectedValues("sizeFilter");

    const selectedConditions =
      getSelectedValues("conditionFilter");

    const selectedPrices =
      getSelectedValues("priceFilter");


    /* =================================================
       CUSTOM SIZE
       ================================================= */

    let customSize = null;

    if (
      customSizeCheck &&
      customSizeCheck.checked &&
      customSizeInput &&
      customSizeInput.value !== ""
    ) {

      customSize =
        parseFloat(customSizeInput.value);

    }

    /* =================================================
       FILTER PRODUCTS
       ================================================= */

    products.forEach(function (product) {

      const brand =
        (
          product.dataset.brand || ""
        )
          .toLowerCase()
          .trim();

      const size =
        parseFloat(
          product.dataset.size
        );

      const condition =
        parseFloat(
          product.dataset.condition
        );

      const price =
        parseFloat(
          product.dataset.price
        );


      /* =============================================
         BRAND
         ============================================= */

      let brandMatch = true;

      if (selectedBrands.length > 0) {

        brandMatch =
          selectedBrands.includes(brand);



      }

      /* =============================================
         SIZE
         ============================================= */

      let sizeMatch = true;

      if (selectedSizes.length > 0) {

        sizeMatch =
          selectedSizes.some(function (selectedSize) {

            return size ===
              parseFloat(selectedSize);
        });
      }

      /* =============================================
         CUSTOM SIZE
         ============================================= */
      if (
        customSize !== null &&
        !isNaN(customSize)
      ) {

        sizeMatch =
          size === customSize;

      }

      /* =============================================
         CONDITION
         ============================================= */

      let conditionMatch = true;

      if (selectedConditions.length > 0) {

        conditionMatch =
          selectedConditions.some(
            function (range) {

              if (range === "90-100") {

                return (
                  condition >= 90 &&
                  condition <= 100
                );

              }

              if (range === "80-89") {

                return (
                  condition >= 80 &&
                  condition <= 89
                );

              }

              if (range === "70-79") {

                return (
                  condition >= 70 &&
                  condition <= 79
                );
              }

              if (range === "below-70") {
                return condition < 70;
              }
              return true;
            }
          );
      }

      /* =============================================
         PRICE
         ============================================= */

      let priceMatch = true;

      if (selectedPrices.length > 0) {

        priceMatch =
          selectedPrices.some(
            function (range) {

              if (range === "under-1000") {

                return price < 1000;

              }

              if (range === "1000-2000") {

                return (
                  price >= 1000 &&
                  price <= 2000
                );

              }

              if (range === "2000-3000") {

                return (
                  price >= 2000 &&
                  price <= 3000
                );

              }

              if (range === "3000-plus") {

                return price >= 3000;

              }
              return true;
            }
          );
      }
      /* =============================================
         FINAL RESULT
         ============================================= */

      const showProduct =
        brandMatch &&
        sizeMatch &&
        conditionMatch &&
        priceMatch;


      if (showProduct) {

        product.style.display = "";

      } else {

        product.style.display = "none";

      }

    });


    updateNoResultsMessage();

    updateSelectedFilters();

  }

  /* =====================================================
     NO RESULTS MESSAGE
     ===================================================== */

  function updateNoResultsMessage() {

    let visibleProducts = 0;

    products.forEach(function (product) {

      if (
        product.style.display !== "none"
      ) {

        visibleProducts++;

      }

    });


    let noResult =
      document.getElementById(
        "realtimeNoResult"
      );


    if (visibleProducts === 0) {

      if (!noResult) {

        noResult =
          document.createElement("div");

        noResult.id =
          "realtimeNoResult";

        noResult.className =
          "col-12 text-center py-5";

        noResult.innerHTML = `
          <h4 class="text-muted">
            No products found.
          </h4>
          <button
            type="button"
            class="btn btn-outline-dark rounded-pill mt-3"
            id="resetRealtimeFilters"
          >
            Clear Filters
          </button>
        `;

        const productGrid =
          products.length > 0
            ? products[0].parentElement
            : null;

        if (productGrid) {

          productGrid.appendChild(
            noResult
          );
        }
      }
    } else {
      if (noResult) {

        noResult.remove();

      }
    }
  }

  /* =====================================================
     BRAND SEARCH
     ===================================================== */

  if (brandSearch) {

    brandSearch.addEventListener(
      "input",
      function () {

        const keyword =
          brandSearch.value
            .toLowerCase()
            .trim();


        const brandOptions =
          document.querySelectorAll(
            "#filter-brand .filter-check"
          );


        brandOptions.forEach(
          function (option) {

            const span =
              option.querySelector("span");


            if (!span) {
              return;
            }


            const text =
              span.textContent
                .toLowerCase();


            if (
              text.includes(keyword)
            ) {

              option.style.display =
                "flex";

            } else {

              option.style.display =
                "none";
            }
          }
        );
      }
    );
  }

  /* =====================================================
     CUSTOM SIZE
     ===================================================== */

  if (
    customSizeCheck &&
    customSizeInput
  ) {

    customSizeCheck.addEventListener(
      "change",
      function () {

        if (this.checked) {

          customSizeInput.style.display =
            "block";

          customSizeInput.focus();

        } else {

          customSizeInput.style.display =
            "none";

          customSizeInput.value = "";

        }
        applyFilters();

      }
    );


    customSizeInput.addEventListener(
      "input",
      function () {

        applyFilters();

      }
    );

  }


  /* =====================================================
     UPDATE SELECTED FILTER TAGS
     ===================================================== */

  function updateSelectedFilters() {

    if (!selectedFilters) {
      return;
    }


    selectedFilters.innerHTML = "";


    const checked =
      document.querySelectorAll(
        ".filter-panel input[type='checkbox']:checked"
      );


    checked.forEach(
      function (checkbox) {

        let text = "";


        const label =
          checkbox.closest(
            ".filter-check"
          );


        if (label) {

          const span =
            label.querySelector(
              "span"
            );


          if (span) {

            text =
              span.textContent.trim();
          }
        }

        if (text) {

          const tag =
            document.createElement(
              "span"
            );

          tag.className =
            "selected-filter-tag";

          tag.innerHTML =
            text +
            ' <button type="button">×</button>';

          const removeButton =
            tag.querySelector(
              "button"
            );

          removeButton.addEventListener(
            "click",
            function () {

              checkbox.checked =
                false;

              applyFilters();

            }
          );

          selectedFilters.appendChild(
            tag
          );
        }
      }
    );

    /* =============================================
       CUSTOM SIZE TAG
       ============================================= */

    if (
      customSizeCheck &&
      customSizeCheck.checked &&
      customSizeInput &&
      customSizeInput.value
    ) {

      const tag =
        document.createElement(
          "span"
        );

      tag.className =
        "selected-filter-tag";

      tag.innerHTML =
        "Size " +
        customSizeInput.value +
        ' <button type="button">×</button>';

      const removeButton =
        tag.querySelector(
          "button"
        );

      removeButton.addEventListener(
        "click",
        function () {

          customSizeCheck.checked =
            false;

          customSizeInput.value =
            "";

          customSizeInput.style.display =
            "none";

          applyFilters();

        }
      );

      selectedFilters.appendChild(
        tag
      );

    }

  }



  /* =====================================================
     CHECKBOX REALTIME
     ===================================================== */

  const allCheckboxes =
    document.querySelectorAll(
      ".filter-panel input[type='checkbox']"
    );


  allCheckboxes.forEach(
    function (checkbox) {

      checkbox.addEventListener(
        "change",
        function () {

          applyFilters();

        }
      );

    }
  );
  /* =====================================================
   CLEAR ALL
   ===================================================== */

if (clearFilters) {
  clearFilters.addEventListener("click", function () {

    // ล้าง checkbox
    document.querySelectorAll('input[name="brandFilter"]').forEach(cb => {
      cb.checked = false;
    });

    document.querySelectorAll('input[name="sizeFilter"]').forEach(cb => {
      cb.checked = false;
    });

    document.querySelectorAll('input[name="conditionFilter"]').forEach(cb => {
      cb.checked = false;
    });

    document.querySelectorAll('input[name="priceFilter"]').forEach(cb => {
      cb.checked = false;
    });

    // ล้าง Custom Size
    if (customSizeCheck) {
      customSizeCheck.checked = false;
    }

    if (customSizeInput) {
      customSizeInput.value = "";
      customSizeInput.style.display = "none";
    }

    // ล้างช่องค้นหา Brand
    if (brandSearch) {
      brandSearch.value = "";
    }

    // รีเซ็ตปุ่ม Filter by
    document.querySelectorAll(".filter-button").forEach(button => {
      button.classList.remove("active");
    });

    // ล้าง filter ที่แสดงอยู่
    updateSelectedFilters();

  });
}
  /* =====================================================
     RESET FROM NO RESULT BUTTON
     ===================================================== */

  document.addEventListener(
    "click",
    function (event) {

      if (
        event.target &&
        event.target.id ===
        "resetRealtimeFilters"
      ) {

        if (clearFilters) {

          clearFilters.click();

        }

      }

    }
  );


  /* =====================================================
     INITIAL
     ===================================================== */

  applyFilters();

});

</script>

