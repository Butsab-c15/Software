    <?- include('../partials/footer') ?>

    <!-- ================= SCRIPT คำนวณและแสดงผลข้อมูล ================= -->
    <script>
      let currentGrandTotal = 0;

      document.addEventListener('DOMContentLoaded', () => {
        const userEmail = localStorage.getItem('userEmail');
        
        const buyNowItem = JSON.parse(localStorage.getItem('checkoutItem'));
        
        let cart = [];
        if (buyNowItem) {
          cart = [buyNowItem];
          localStorage.removeItem('checkoutItem');
        } else {
          const cartKey = userEmail ? ('cart_' + userEmail) : 'tempCart';
          cart = JSON.parse(localStorage.getItem(cartKey)) || [];
        }

        const urlParams = new URLSearchParams(window.location.search);
        const shippingCost = parseInt(urlParams.get('shipping_cost')) || 0;

        const container = document.getElementById('checkout-items-container');

        if (cart.length === 0) {
          container.innerHTML = `<p class="text-center text-muted py-3 mb-0">ไม่มีสินค้าในคำสั่งซื้อนี้</p>`;
          return;
        }

        let subtotal = 0;
        let html = '';

        cart.forEach(item => {
          let rawPrice = item.price ? String(item.price) : "0";
          let priceNum = parseInt(rawPrice.replace(/,/g, '')) || 0;
          subtotal += priceNum;

          html += `
            <div class="d-flex align-items-center gap-3 pb-3 border-bottom mb-3">
              <div style="width: 90px; height: 90px; background-color: #f4f4f4;" class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0">
                <img src="${item.image || ''}" alt="${item.name || ''}" class="img-fluid rounded-3" style="max-height: 80%; object-fit: contain;">
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold mb-1">${item.name || 'สินค้า'}</h6>
                <p class="text-muted small mb-1">Size ${item.size || '-'}</p>
                <span class="badge bg-light text-secondary border fw-normal">กล่อง</span>
              </div>
              <div class="text-end">
                <h6 class="fw-bold mb-0">฿ ${item.price}</h6>
              </div>
            </div>
          `;
        });

        container.innerHTML = html;

        let grandTotal = subtotal + shippingCost;
        currentGrandTotal = grandTotal;

        document.getElementById('sum-subtotal').innerText = '฿ ' + subtotal.toLocaleString();
        document.getElementById('sum-shipping').innerText = shippingCost === 0 ? 'ฟรี' : ('฿ ' + shippingCost.toLocaleString());
        document.getElementById('summary-shipping-fee').innerText = shippingCost === 0 ? 'ฟรี' : ('฿ ' + shippingCost.toLocaleString());
        document.getElementById('sum-total').innerText = '฿ ' + grandTotal.toLocaleString();
        document.getElementById('btn-total-price').innerText = '฿ ' + grandTotal.toLocaleString();

        renderAddress();
        
        const savedPayment = localStorage.getItem('selectedPayment') || 'บัตรเครดิต/เดบิต';
        document.getElementById('selected-payment-text').innerText = savedPayment;
        toggleCardSection(savedPayment);
      });

      function toggleCardSection(method) {
        const cardSection = document.getElementById('card-details-section');
        if (method === 'บัตรเครดิต/เดบิต') {
          cardSection.classList.remove('d-none');
        } else {
          cardSection.classList.add('d-none');
        }
      }

      function processCheckout() {
        const savedAddress = localStorage.getItem('shippingAddress');
        if (!savedAddress) {
          alert('กรุณากรอก "ที่อยู่จัดส่ง" ก่อนดำเนินการชำระเงิน');
          return;
        }

        const paymentMethod = localStorage.getItem('selectedPayment') || 'บัตรเครดิต/เดบิต';

        if (paymentMethod === 'QR PromptPay') {
          window.location.href = `/qr-payment?total=${currentGrandTotal}`;
          return;
        }

        if (paymentMethod === 'บัตรเครดิต/เดบิต') {
          const cardNum = document.getElementById('card-number').value.trim();
          const cardExp = document.getElementById('card-expiry').value.trim();
          const cardCvv = document.getElementById('card-cvv').value.trim();
          if (!cardNum || !cardExp || !cardCvv) {
            alert('กรุณากรอกข้อมูลบัตรเครดิต/เดบิตให้ครบถ้วน');
            return;
          }
        }

        const toastEl = document.getElementById('successToast');
        const toast = new bootstrap.Toast(toastEl, { delay: 10000 });
        toast.show();

        const userEmail = localStorage.getItem('userEmail');
        const cartKey = userEmail ? ('cart_' + userEmail) : 'tempCart';
        localStorage.removeItem(cartKey);
        localStorage.removeItem('shippingAddress');
        localStorage.removeItem('selectedPayment');

        setTimeout(() => {
          window.location.href = '/';
        }, 3500);
      }

      function saveAddress(event) {
        event.preventDefault();
        const addressData = {
          name: document.getElementById('inp-name').value,
          phone: document.getElementById('inp-phone').value,
          address: document.getElementById('inp-address').value
        };

        localStorage.setItem('shippingAddress', JSON.stringify(addressData));

        const modalEl = document.getElementById('addressModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();

        renderAddress();
      }

      function renderAddress() {
        const saved = localStorage.getItem('shippingAddress');
        if (saved) {
          const data = JSON.parse(saved);
          document.getElementById('disp-name').innerText = data.name + ' (' + data.phone + ')';
          document.getElementById('disp-phone').innerText = '';
          document.getElementById('disp-address').innerText = data.address;

          document.getElementById('address-content-unfilled').classList.add('d-none');
          document.getElementById('address-content-filled').classList.remove('d-none');
          document.getElementById('address-display-box').classList.remove('border-warning');
          document.getElementById('address-display-box').classList.add('border-success');
        }
      }

      function selectPayment(method) {
        document.getElementById('selected-payment-text').innerText = method;
        localStorage.setItem('selectedPayment', method);
        toggleCardSection(method);

        const modalEl = document.getElementById('paymentModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
      }
    </script>
  </body>
</html>
