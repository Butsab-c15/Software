<!doctype html>
<html lang="en">

<?- include('../partials/head') -?>

<head>

<style>

    body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #f5f6fa;
        color: #2d3436;
    }

    /* Register area */
    .register-wrapper {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Register box */
    .register-box {
        width: 100%;
        max-width: 480px;
        background: #ffffff;
        padding: 40px;
        border-radius: 12px;
        border: 1px solid #eeeeee;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    /* Title */
    .register-title {
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        text-align: center;
        margin-bottom: 8px;
        color: #222222;
    }

    .register-subtitle {
        text-align: center;
        color: #888888;
        font-size: 14px;
        margin-bottom: 30px;
    }

    /* Small line */
    .title-line {
        width: 45px;
        height: 3px;
        background: #343a40;
        margin: 0 auto 15px;
        border-radius: 10px;
    }

    /* Label */
    .register-box label {
        font-size: 14px;
        font-weight: 600;
        color: #444444;
        margin-bottom: 7px;
    }

    /* Input */
    .register-input {
        height: 48px;
        border: 1px solid #dddddd;
        border-radius: 7px;
        padding: 0 15px;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .register-input:focus {
        border-color: #343a40;
        box-shadow: 0 0 0 3px rgba(52, 58, 64, 0.08);
    }

    /* Button */
    .register-button {
        height: 48px;
        border-radius: 7px;
        background: #343a40;
        border: none;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
    }

    .register-button:hover {
        background: #212529;
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }

    /* Login */
    .login-text {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: #888888;
    }

    .login-text a {
        color: #343a40;
        font-weight: 600;
        text-decoration: none;
    }

    .login-text a:hover {
        text-decoration: underline;
    }

    /* Error */
    .register-error {
        font-size: 14px;
        border-radius: 7px;
    }

</style>

</head>

<body>

<?- include('../partials/header') -?>
<?- include('../partials/nav') -?>


<div class="container">

    <div class="register-wrapper">

