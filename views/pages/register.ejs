                        data-dismiss="alert"
                        aria-label="Close">

                    <span aria-hidden="true">&times;</span>

                </button>

            </div>

            <? } ?>


            <!-- Register Form -->
            <form action="<?= registerAction ?>"
                  method="POST"
                  novalidate>


                <!-- Name -->
                <div class="form-group">

                    <label for="name">
                        Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        class="form-control register-input"
                        name="name"
                        value="<?= user.name ?>"
                        placeholder="Enter your name"
                    >

                </div>


                <!-- Email -->
                <div class="form-group">

                    <label for="email">
