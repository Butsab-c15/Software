  <!-- =====================================================
       TOAST
  ====================================================== -->

  <div
    class="position-fixed top-0 end-0 p-3"
    style="z-index:1080"
  >

    <div
      id="cartToast"
      class="toast align-items-center text-bg-dark border-0 shadow-lg rounded-pill"
      role="alert"
      data-bs-delay="2500"
    >

      <div class="d-flex">

        <div
          id="toastMessage"
          class="toast-body fw-bold"
        ></div>

        <button
