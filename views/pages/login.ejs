<!doctype html>
<html lang="en">

<?- include('../partials/head') -?>

<head>

<style>

    /* Font */
    body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #f5f6fa;
        color: #2d3436;
    }

    /* Login area */
    .login-wrapper {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Login box */
    .login-box {
        width: 100%;
        max-width: 430px;
        background: #ffffff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #eeeeee;
    }

    /* Title */
    .login-title {
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        text-align: center;
        margin-bottom: 8px;
        color: #222222;
    }

    .login-subtitle {
        text-align: center;
        color: #888888;
        font-size: 14px;
        margin-bottom: 30px;
    }

    /* Small line under title */
    .title-line {
        width: 45px;
        height: 3px;
        background: #343a40;
        margin: 0 auto 15px;
        border-radius: 10px;
    }

    /* Labels */
    .login-box label {
        font-size: 14px;
        font-weight: 600;
        color: #444444;
        margin-bottom: 7px;
    }

    /* Input */
    .login-input {
        height: 48px;
        border: 1px solid #dddddd;
        border-radius: 7px;
        padding: 0 15px;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .login-input:focus {
        border-color: #343a40;
        box-shadow: 0 0 0 3px rgba(52, 58, 64, 0.08);
    }

    /* Login button */
    .login-button {
        height: 48px;
        border-radius: 7px;
        background: #343a40;
        border: none;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
    }

    .login-button:hover {
        background: #212529;
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }

    /* Register */
    .register-text {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: #888888;
    }

    .register-text a {
        color: #343a40;
        font-weight: 600;
        text-decoration: none;
    }

    .register-text a:hover {
        text-decoration: underline;
    }

    /* Error */
    .login-error {
        font-size: 14px;
        border-radius: 7px;
    }

</style>

</head>

<body>

<?- include('../partials/header') -?>
<?- include('../partials/nav') -?>


<div class="container">

    <div class="login-wrapper">

        <div class="login-box">

            <!-- Title -->
            <h1 class="login-title">
                LOGIN
            </h1>

            <div class="title-line"></div>

            <p class="login-subtitle">
                Sign in to continue to your account
            </p>


            <!-- Error -->
            <? if(typeof errors !== 'undefined'){ ?>

            <div class="alert alert-warning alert-dismissible fade show login-error"
                 role="alert">

                <?= errors.message ?>

                <button type="button"
                        class="close"
                        data-dismiss="alert"
                        aria-label="Close">

                    <span aria-hidden="true">&times;</span>

                </button>

            </div>

            <? } ?>


            <!-- Form -->
            <form action="<?= loginAction ?>"
                  method="POST"
                  novalidate>


                <!-- Email -->
                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        class="form-control login-input"
                        name="email"
                        value="<?= user.email ?>"
                        placeholder="Enter your email"
                    >

                </div>


                <!-- Password -->
                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        class="form-control login-input"
                        name="password"
                        value="<?= user.password ?>"
                        placeholder="Enter your password"
                    >

                </div>


                <!-- Button -->
                <div class="form-group mt-4">

                    <button
                        type="submit"
                        class="btn btn-dark btn-block login-button">

                        Login

                    </button>

                </div>

            </form>


            <!-- Register -->
            <div class="register-text">

                Don't have an account?

                <a href="/register">
                    Register
                </a>

            </div>

        </div>

    </div>

</div>


<?- include('../partials/footer') -?>

</body>
</html>
